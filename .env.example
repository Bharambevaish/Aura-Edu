# Copy to .env (local) or enter each in Vercel → Settings → Environment Variables.
# Never commit real values. Step-by-step: docs/DEPLOYMENT.md.

# ─── MongoDB ────────────────────────────────────────────────────────────────
# Connection string. Atlas: Database → Connect → Drivers; URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@cluster2.1tgshhd.mongodb.net/AuraEdu?retryWrites=true&w=majority&appName=Cluster2
# Local dev instead (`npm run mongo`):
# MONGODB_URI=mongodb://127.0.0.1:27017/auraedu

# Optional: database name, used only when MONGODB_URI has no /<database> path (default "auraedu").
# MONGODB_DB=AuraEdu

# ─── Auth.js (NextAuth v5) ──────────────────────────────────────────────────
# Session signing secret: `openssl rand -base64 32` (or see DEPLOYMENT.md); a different one per deployment.
AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# Public URL of the app, no trailing slash (production: https://<project>.vercel.app or your custom domain).
AUTH_URL=http://localhost:3000

# Trust the host header from Vercel's proxy; keep "true".
AUTH_TRUST_HOST=true

# ─── Demo features ──────────────────────────────────────────────────────────
# "true" only for the sales demo: one-click demo logins, demo banner, "Reset demo data". Leave unset for real institutes.
DEMO_MODE=true
