# ─── MongoDB ────────────────────────────────────────────────────────────────
# Local dev: `npm run mongo` runs a local server (see scripts/dev-mongo.mjs);
# both local-URI options work.
#   MONGODB_URI=mongodb://127.0.0.1:27017/myedou
#
# Going live: Atlas SRV string. No code changes are needed — this is the only
# switch. Create a free cluster: MongodB Atlas -> Database Access (add DB user)
# -> Network Access (allow your IP) -> copy the SRV string:
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ─── Auth.js (NextAuth v5) secrets ──────────────────────────────────────────
# JWT signing secret. Generate one and rotate it regularly:
#   openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# The canonical public URL of the app. Local dev:
AUTH_URL=http://localhost:3000
# Production (Vercel) sets this automatically to your deployment URL; override
# only when using a custom domain:
# AUTH_URL=https://your-app.vercel.app

# Trust the proxy/host so Auth.js works behind Vercel and local dev.
AUTH_TRUST_HOST=true